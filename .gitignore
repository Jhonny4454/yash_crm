# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/
.env/

# ── Secrets — NEVER commit these ─────────────────────────────────────────────
.env
.env.local
.env.*.local
*.key
*.pem
*.p12

# ── Database / instance data ──────────────────────────────────────────────────
instance/
*.db
*.sqlite3
*.sqlite
backups/

# ── User-uploaded files (customer data — not for git) ────────────────────────
static/uploads/

# ── OS junk ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*~

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
pip-log.txt

# ── Build / dist ─────────────────────────────────────────────────────────────
*.egg-info/
dist/
build/
.eggs/
MANIFEST

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml

# ── Render / Railway / Heroku ─────────────────────────────────────────────────
.render/
.railway/

# ── Keep these placeholder folders tracked ───────────────────────────────────
!static/uploads/.gitkeep
!instance/.gitkeep
