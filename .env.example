# ============================================================================
#  YASH Internet Services CRM  —  environment configuration
#  Copy this file to `.env` and fill in real values before deploying.
# ============================================================================

# --- REQUIRED IN PRODUCTION -------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to "production" to enforce secure cookies and disable debug mode.
FLASK_ENV=production

# --- DATABASE ---------------------------------------------------------------
# Leave blank to use SQLite (instance/app.db) — fine for a single small server.
# MySQL / MariaDB example:
#   DATABASE_URL=mysql+pymysql://user:password@localhost/yash_crm?charset=utf8mb4
DATABASE_URL=

# --- ENCRYPTION FOR STORED ISP API SECRETS ----------------------------------
# Required before you can save ISP credentials (Log2Space / Synnefo / JPR).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_KEY=

# --- RAZORPAY (optional) ----------------------------------------------------
# Leave blank to disable online payments; the app handles this gracefully.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- SERVER -----------------------------------------------------------------
PORT=5000
WEB_CONCURRENCY=1
LOG_LEVEL=info
