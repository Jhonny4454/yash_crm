# ============================================================================
#  YASH Internet Services CRM  —  environment configuration
#  Copy this file to `.env` and fill in real values before deploying.
# ============================================================================

# --- REQUIRED IN PRODUCTION -------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to "production" to enforce secure cookies and disable debug mode.
FLASK_ENV=production

# First-boot admin password (change it after the first login either way)
ADMIN_PASSWORD=

# --- DATABASE ---------------------------------------------------------------
# Leave blank for SQLite (instance/app.db).
# MySQL:    DATABASE_URL=mysql+pymysql://user:pass@host/yash_crm?charset=utf8mb4
# Postgres: supplied automatically by Render / Railway
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- ENCRYPTION FOR STORED ISP API SECRETS ----------------------------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_KEY=

# ============================================================================
#  CASHFREE PAYMENT GATEWAY
#  Leave blank to disable online payment - the portal hides the Pay button.
#  Values can also be set from the admin UI, which overrides these.
# ============================================================================
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Webhook to register in the Cashfree dashboard:
#   https://your-domain.com/webhooks/cashfree

# ============================================================================
#  WHATSAPP / SMS GATEWAY
#  Editable later from the settings table without a redeploy.
#
#  {phone} {message} {token} {instance_id} {sender} are substituted into both
#  the URL and the payload template.
# ============================================================================
WA_ENABLED=0
WA_PROVIDER=generic
WA_API_URL=
WA_API_TOKEN=
WA_INSTANCE_ID=
WA_COUNTRY_CODE=91

# --- LINKS USED INSIDE MESSAGE TEMPLATES ------------------------------------
APP_LINK=https://bit.ly/4bBo8kd
WEB_LINK=https://yashinternetservices.in

# --- SERVER -----------------------------------------------------------------
PORT=5000
WEB_CONCURRENCY=1
WEB_THREADS=4
LOG_LEVEL=info
TZ=Asia/Kolkata
STATIC_CACHE_SECONDS=604800

# Only ONE process should run the scheduler. If you scale to more than one
# worker, set RUN_SCHEDULER=0 on every worker except one.
RUN_SCHEDULER=1
