# ============================================================
#  YASH Internet Services CRM — environment variables
#
#  1. Copy this file:   cp .env.example .env
#  2. Fill in the values below
#  3. NEVER commit .env to git
#
#  THIS FILE IS COMMITTED TO GIT. It is the template, not the
#  configuration. Every value here must stay blank or be a
#  harmless default - a real key pasted into this file is a real
#  key published to the repository. Put real values in `.env`,
#  which .gitignore excludes, or in Settings in the admin panel.
# ============================================================

# ---- REQUIRED -----------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 'production' or 'development'
FLASK_ENV=production

# Admin account password on first boot (change immediately after login)
ADMIN_PASSWORD=change_me_now

# ---- DATABASE -----------------------------------------------
# Leave blank for SQLite (fine for a single server, not for Render free tier)
# MySQL:    mysql+pymysql://user:pass@host/dbname?charset=utf8mb4
# Postgres: postgresql+psycopg2://user:pass@host/dbname
# Render sets this automatically from the linked database.
DATABASE_URL=

# ISP credential encryption key
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_KEY=

# ---- CASHFREE PAYMENT GATEWAY --------------------------------
# Leave blank to disable online payment in the customer portal.
#
# Sandbox and production credentials are NOT interchangeable: each host
# rejects the other's keys with the same unhelpful "authentication Failed".
# A sandbox App ID begins with TEST and a sandbox secret carries "test" in
# the middle; a production secret carries "prod" instead. CASHFREE_ENV must
# match whichever pair is in use, in lower case.
#
# A row in the settings table wins over these, so Settings -> Payment Gateway
# in the admin panel is the better place to put them: it covers the deployed
# server as well as this machine, and nothing lands in a file that git can see.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# ---- WHATSAPP GATEWAY ---------------------------------------
# Settings can also be edited in the admin UI (Settings page)
WA_ENABLED=0
WA_API_URL=
WA_API_TOKEN=
WA_INSTANCE_ID=
WA_COUNTRY_CODE=91

# ---- CLOUD FILE STORAGE + BACKUPS ---------------------------
# Where uploaded files and database backups are kept.
#
# Why this matters here specifically: this application is deployed on a
# platform that rebuilds the container's disk on every deploy. Everything
# under static/uploads - the company logo, KYC documents, payment proof
# screenshots - is erased each time the service is redeployed, and so is
# anything the backup job wrote to the local backups/ folder. Nothing errors;
# the records go on naming files that no longer exist.
#
# STORAGE_BACKEND=s3 points all of that at a bucket instead. Any S3-compatible
# host works - only the endpoint changes:
#   Cloudflare R2   https://<account-id>.r2.cloudflarestorage.com   (region: auto)
#   Backblaze B2    https://s3.<region>.backblazeb2.com
#   Wasabi          https://s3.<region>.wasabisys.com
#   Amazon S3       leave blank, set the real region
#   Supabase        https://<project>.supabase.co/storage/v1/s3
#
# These override the matching rows in the settings table, so the admin panel
# can be used instead when nobody has access to the hosting dashboard. The
# environment is the better place for the secret key: it is then not in the
# database, and therefore not inside a backup of the database.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional, and only used for the company logo (which is printed on bills and
# is not confidential). KYC documents and payment proofs are never served from
# a public URL - they always go through an expiring signed link.
S3_PUBLIC_BASE_URL=

# ---- LINKS IN TEMPLATES -------------------------------------
APP_LINK=https://bit.ly/4bBo8kd
WEB_LINK=https://yashinternetservices.in

# ---- SERVER -------------------------------------------------
PORT=5000
WEB_CONCURRENCY=1
WEB_THREADS=4
TZ=Asia/Kolkata
LOG_LEVEL=info
RUN_SCHEDULER=1
