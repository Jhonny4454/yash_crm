# /opt/yash-crm/.env   —   chmod 600, owned by yashcrm
#
# Keys mirrored from your existing .env.example and render.yaml so nothing the
# app reads goes missing in the move. Fill in every REPLACE_ME.

# ---- Core ------------------------------------------------------------------
FLASK_ENV=production
SECRET_KEY=REPLACE_ME            # python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_ME        # a DIFFERENT value from SECRET_KEY
CREDENTIAL_KEY=REPLACE_ME        # encrypts ISPCredential rows -- lose it, lose them
TZ=Asia/Kolkata
LOG_LEVEL=info

# ---- Database (local MySQL from setup.sh) ----------------------------------
DATABASE_URL=mysql+pymysql://yashcrm:REPLACE_ME@127.0.0.1/yashcrm?charset=utf8mb4

# ---- Process model ---------------------------------------------------------
PORT=8000
# DO NOT RAISE. APScheduler runs in-process; 2 workers = every nightly job
# fires twice. Throughput comes from threads instead.
WEB_CONCURRENCY=1
WEB_THREADS=8
RUN_SCHEDULER=1

# ---- Public identity -------------------------------------------------------
# Meta fetches invoice/receipt PDFs from URLs built on this. If it is wrong or
# not publicly reachable, document templates fail and the customer gets nothing.
PUBLIC_BASE_URL=https://crm.yashinternetservices.com
WEB_LINK=https://crm.yashinternetservices.com
APP_LINK=https://crm.yashinternetservices.com
CORS_ORIGINS=https://crm.yashinternetservices.com

# ---- WhatsApp (WabAssist) --------------------------------------------------
WA_ENABLED=1
WA_API_URL=https://api.wabassist.com/api/v1/messages/template
WA_API_TOKEN=REPLACE_ME
WA_COUNTRY_CODE=91
WA_INSTANCE_ID=

# ---- Payments --------------------------------------------------------------
CASHFREE_ENV=production
CASHFREE_APP_ID=REPLACE_ME
CASHFREE_SECRET_KEY=REPLACE_ME

# ---- Mail ------------------------------------------------------------------
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Limits / tuning -------------------------------------------------------
MAX_UPLOAD_MB=32
SLOW_REQUEST_MS=2000
LOGIN_MAX_ATTEMPTS=5
JWT_ACCESS_MINUTES=60

# ---- Storage ---------------------------------------------------------------
# 'local' keeps uploads and backups on this disk. Point at S3/R2/B2 later if
# you want backups off the box -- boto3 is already in requirements.txt.
STORAGE_BACKEND=local

# ---- First boot only -------------------------------------------------------
# wsgi.py seeds the admin account on first start. Set it, start once, then
# blank it out and restart.
ADMIN_PASSWORD=
